{
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "lua/?.lua",
      "lua/?/init.lua",
      "?/lua/?.lua",
      "?/lua/?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME",
      "$LLS_Addons/luvit",
      "$HOME/.local/share/nvim/lazy",
      "/usr/share/nvim/runtime/lua",
      "$HOME/.local/share/nvim/lazy/lazy.nvim/lua"
    ],
    "ignoreGlobs": ["**/*_spec.lua"]
  },
  "diagnostics": {
    "globals": ["vim"]
  }
}
